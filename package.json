{
  "name": "3il-prisma-authentification",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.6.0",
    "@prisma/client": "7.6.0",
    "argon2": "0.44.0",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-rate-limit": "8.2.1",
    "helmet": "8.1.0",
    "jose": "6.1.3"
  },
  "devDependencies": { "prisma": "7.10.0" }
}
